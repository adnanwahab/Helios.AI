# Local development. In production these are set in the Netlify UI (Site configuration → Environment variables).
# Without SUPABASE_DB_URL the dev server uses a local PGlite database in HELIOS_PGLITE_DIR.
PORT=3000
HOST=127.0.0.1
HELIOS_PGLITE_DIR=.data/pglite
# Supabase: Project settings → Database → Connection string → Transaction pooler (port 6543).
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SUPABASE_CA_CERT=-----BEGIN CERTIFICATE-----...   (optional; the root certificate from the Supabase dashboard)
# HELIOS_ADMIN_TOKEN=use-a-long-random-secret-from-your-secret-manager
# PUBLIC_ORIGINS=https://helioshtml.com,https://www.helioshtml.com
# Email (Resend); see docs/email.md.
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...
# EMAIL_FROM=Helios <hello@your-verified-domain>
# EMAIL_REPLY_TO=reply@your-resend-receiving-address
# EMAIL_GOAL_ID=HGA-078
# EMAIL_DELAY_HOURS=72
# PUBLIC_BASE_URL=https://helioshtml.com
# Notion (Plan · Notion screen); see docs/notion.md.
# NOTION_TOKEN=ntn_...                     (internal integration secret)
# NOTION_PARENT_PAGE_ID=https://www.notion.so/Helios-<32-hex-id>   (page shared with the integration; new plan pages go under it)
# NOTION_PAGE_ID=<32-hex-id>                (optional: pin the screen to an existing page instead of the last published one)
# NOTION_CACHE_MS=60000
