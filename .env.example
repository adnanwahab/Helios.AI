# Local development. In production these are set in the Netlify UI (Site configuration → Environment variables).
# Without SUPABASE_DB_URL the dev server uses a local PGlite database in HELIOS_PGLITE_DIR.
PORT=3000
HOST=127.0.0.1
HELIOS_PGLITE_DIR=.data/pglite
# Supabase: Project settings → Database → Connection string → Transaction pooler (port 6543).
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SUPABASE_CA_CERT=-----BEGIN CERTIFICATE-----...   (optional; the root certificate from the Supabase dashboard)
# HELIOS_ADMIN_TOKEN=use-a-long-random-secret-from-your-secret-manager
# PUBLIC_ORIGINS=https://helioshtml.com,https://www.helioshtml.com
# Email (Resend); see docs/email.md.
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...
# EMAIL_FROM=Helios <hello@your-verified-domain>
# EMAIL_REPLY_TO=reply@your-resend-receiving-address
# EMAIL_GOAL_ID=HGA-078
# EMAIL_DELAY_HOURS=72
# PUBLIC_BASE_URL=https://helioshtml.com
# EMAIL_AUTO_REPLY=1                (0 turns off the immediate reply to inbound mail)
# EMAIL_AUTO_REPLY_PER_DAY=3
# MorphLab: server-side OpenAI only; opt-in to avoid unexpected API charges.
# MORPHLAB_ENABLED=1
# OPENAI_API_KEY=sk-...    (secret; never place in HTML or public/)
# OPENAI_MODEL=<available-Responses-model-with-structured-output>
# Law drafting uses the same server key/model and requires explicit enablement.
# CONSENSUS_AI_ENABLED=1
# Automatic proposal PRs; fixed to adnanwahab/HeliosHTML. Never put token in public/.
# HELIOS_GITHUB_PR_ENABLED=1
# HELIOS_GITHUB_TOKEN=<repository-scoped-token-with-contents-and-pull-requests-write>
# Research queue API authentication; server-only, at least 32 characters.
# HELIOS_RESEARCH_WORKER_TOKEN=<dedicated-random-worker-secret>
# Separate worker process configuration; see docs/research-worker.md.
# HELIOS_RESEARCH_API_BASE_URL=https://helioshtml.com
# HELIOS_RESEARCH_ROOM_ID=room-...
# HELIOS_RESEARCH_MODEL=<available-Responses-model-with-web-search>
# HELIOS_RESEARCH_CONCURRENCY=2
# HELIOS_RESEARCH_MAX_TASKS=100
# Notion (Plan · Notion screen); see docs/notion.md.
# NOTION_TOKEN=ntn_...                     (internal integration secret)
# NOTION_PARENT_PAGE_ID=https://www.notion.so/Helios-<32-hex-id>   (page shared with the integration; new plan pages go under it)
# NOTION_PAGE_ID=<32-hex-id>                (optional: pin the screen to an existing page instead of the last published one)
# NOTION_CACHE_MS=60000

# Optional isolated Netlify Deploy Preview database, Functions scope, Deploy Previews only.
# Never point these at the production project. Both must be configured to enable preview writes.
# HELIOS_PREVIEW_DB_URL=postgresql://postgres.<test-ref>:<password>@<pooler-host>:6543/postgres
# HELIOS_PREVIEW_WRITES=1
# HELIOS_PREVIEW_CA_CERT=... (optional test database CA)
