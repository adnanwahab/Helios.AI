# A *small, explicit* Fly/Docker build context.
# Docker reads .dockerignore from the CONTEXT ROOT, not from a nested repo.
# Always run: fly deploy . --dockerfile Dockerfile (from this repository's root).
#
# The runtime needs only package metadata, HTML pages, the application code,
# the catalog, public assets, and Netlify redirect rules.
# Default-deny local clones, datasets, node_modules, test artifacts and secrets.
*
!Dockerfile
!package.json
!bun.lock
!netlify.toml
!index.html
!*.html
!robots.txt
!sitemap.xml
!src/
!src/**
!scripts/
!scripts/**
!public/
!public/**
!data/
!data/catalog.json

# Only tracked build inputs for the fixed synthetic Consensus Lab report.
# Do not include generated runs, custom bill inputs, tests or local files.
!consensus-lab/
consensus-lab/**
!consensus-lab/src/
!consensus-lab/src/preview.ts
!consensus-lab/src/report.ts
!consensus-lab/src/simulate.ts
!consensus-lab/src/model.ts
!consensus-lab/src/types.ts
!consensus-lab/data/
!consensus-lab/data/bills.example.json
!consensus-lab/data/model-metadata.json
# Only this archived HTML file is needed at build time; keep other docs excluded.
!docs/
docs/**
!docs/legacy-home.html

# Defensive exclusions inside otherwise allowed directories.
**/.git
**/node_modules
**/.env
**/.env.*
**/.data
**/.DS_Store
**/.netlify
**/.cache
**/.next
**/.turbo
**/dist
**/dist-pages
**/coverage
**/test-results
**/playwright-report
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/*.log
**/*.zip
**/Helios.AI
