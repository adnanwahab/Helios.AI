# Separate worker image: no web server, database directory, or app volume.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY src/mini-symphony-worker.js ./src/mini-symphony-worker.js
COPY scripts/mini-symphony-worker.mjs ./scripts/mini-symphony-worker.mjs
COPY package.json ./package.json
USER node
CMD ["node", "scripts/mini-symphony-worker.mjs"]
